# ─────────────────────────────────────────────────────────────────────────────
# HJ Track — шаблон переменных окружения.
# Скопируйте в `.env.local` и подставьте реальные значения:
#     cp .env.example .env.local
# ВАЖНО: реальные .env-файлы НЕ коммитятся (см. .gitignore: .env*).
# На проде значения берутся из Vercel → Project → Settings → Environment Variables,
# а НЕ из этого файла (при деплое .env* исключён через .vercelignore).
#
# Эти переменные нужны ТОЛЬКО серверным функциям в api/*.
# Firebase-конфиг фронтенда (apiKey и т.п.) — публичный и захардкожен в
# src/lib/firebase.js, отдельных VITE_-переменных для него не требуется.
# ─────────────────────────────────────────────────────────────────────────────

# ── ИИ-помощник (api/assistant.js) ──
# Ключ Google AI Studio: https://aistudio.google.com/apikey (формат AIzaSy...)
GEMINI_API_KEY=your_google_ai_studio_key
# Модель Gemini. По умолчанию в коде gemini-flash-latest; на проде — gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# ── Firebase Admin SDK (api/send-push.js, api/checkin.js) ──
# Из сервис-аккаунта Firebase (Project settings → Service accounts → Generate key)
FIREBASE_PROJECT_ID=hjtrack-928f5
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@hjtrack-928f5.iam.gserviceaccount.com
# Приватный ключ в кавычках, переносы строк как \n (код сам заменяет \n на реальные)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Slack (api/slack-notify.js) ──
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# ── Секреты внутренних эндпоинтов ──
# api/release-note.js — публикация релиз-новостей
RELEASE_NOTE_SECRET=some_long_random_secret
# api/sync-visits.js — синхронизация визитов
SYNC_SECRET=some_long_random_secret

# ── Daily.co (видеозвонки, если используется) ──
DAILY_API_KEY=your_daily_api_key
