# ─────────────────────────────────────────────────────────────────────────────
# HJ Track — шаблон переменных окружения для ЛОКАЛЬНОГО запуска.
#
#   cp .env.example .env.local      # и подставить реальные значения
#   npm run dev                     # только фронт (Vite) — переменные НЕ нужны
#   vercel dev                      # фронт + серверные функции api/* — нужны переменные ниже
#
# Реальные .env-файлы НЕ коммитятся (.gitignore: .env*). На проде значения живут
# в Vercel → Project → Settings → Environment Variables. Там они помечены
# «Sensitive» (замок) и ОБРАТНО НЕ ЧИТАЮТСЯ — ни в интерфейсе, ни через
# `vercel env pull` (приходят пустыми). Поэтому значения берутся из первоисточников,
# указанных у каждой переменной, или генерируются заново.
#
# Firebase-конфиг фронтенда (apiKey и т.п.) публичный и захардкожен в
# src/lib/firebase.js — отдельных VITE_-переменных не требуется.
# ─────────────────────────────────────────────────────────────────────────────

# ── Firebase Admin SDK (пуши, чекин, новости, счётчики; api/_lib) ──
# Firebase console → ⚙ Project settings → Service accounts → Generate new private key
# https://console.firebase.google.com/project/hjtrack-928f5/settings/serviceaccounts/adminsdk
# Новый ключ НЕ отключает старый на проде. Из скачанного JSON: project_id, client_email, private_key.
FIREBASE_PROJECT_ID=hjtrack-928f5
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@hjtrack-928f5.iam.gserviceaccount.com
# Приватный ключ в кавычках, переносы строк как \n (код сам заменяет \n на реальные)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Firebase Storage в проекте НЕ включён (файлы хранятся base64 в Firestore) — можно оставить как есть
FIREBASE_STORAGE_BUCKET=hjtrack-928f5.appspot.com

# ── Gemini (api/assistant.js, api/release-note.js, api/news-rewrite.js) ──
# Ключ Google AI Studio: https://aistudio.google.com/apikey — существующие ключи там видны, можно создать новый
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-2.5-flash
# Классификатор лидов (необязательно, по умолчанию gemini-2.5-flash)
GEMINI_LEAD_MODEL=gemini-2.5-flash

# ── Академия: SSO (api/academy-token.js) ──
# Сервис-аккаунт Firebase-проекта АКАДЕМИИ (не HJ Track): его console → Service accounts → Generate key
ACADEMY_PROJECT_ID=academy-project-id
ACADEMY_CLIENT_EMAIL=firebase-adminsdk-xxxxx@academy-project-id.iam.gserviceaccount.com
ACADEMY_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Slack (api/slack-notify.js) ──
# https://api.slack.com/apps → приложение → Incoming Webhooks — URL видны там
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
# Отдельный канал InStudio
SLACK_WEBHOOK_INSTUDIO=https://hooks.slack.com/services/XXX/YYY/ZZZ

# ── Секреты внутренних эндпоинтов (наши случайные строки) ──
# Для локального запуска подойдут ЛЮБЫЕ случайные строки: они должны совпадать только
# у вызывающей и принимающей стороны. Прод-значения нужны лишь чтобы ходить в прод-API.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# api/token.js — SSO-токены и подпись вызовов
TOKEN_SECRET=some_long_random_secret
# api/scheduled-reminders.js, dwh-sync/ — синхронизация визитов и напоминания по расписанию
SYNC_SECRET=some_long_random_secret
# api/release-note.js — публикация релиз-новостей из Slack
RELEASE_NOTE_SECRET=some_long_random_secret
# api/merch-sync.js — заголовок x-api-key платформы маркетинга (на проде должен совпадать с их стороной)
MERCH_API_KEY=some_long_random_secret

# ── Только для dwh-sync/ на ноутбуке (не для Vercel) ──
# Строка подключения к Postgres DWH, работает только через OpenVPN
# POSTGRES_DWH=postgres://user:pass@host:5432/db
