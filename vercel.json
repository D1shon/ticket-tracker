{
  "crons": [
    {
      "path": "/api/cleanup-checkout-photos",
      "schedule": "0 3 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/model/:slug",
      "destination": "/models/:slug/index.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/((?!assets/|api/).*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
